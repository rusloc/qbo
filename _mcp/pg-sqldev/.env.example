# pg-sqldev connection file. Copy to .env in this folder and fill in.
# Use a dedicated READ-ONLY role (see README.md, step 1). Never commit .env.

# Required
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Optional (defaults in brackets)
# PGPORT=5432
# Comma-separated schemas the tools may describe. Set this: the code default is project-specific.
PG_SCHEMAS=public
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_LOCK_TIMEOUT_MS=2000
# PG_CACHE_TTL_S=600
# PG_POOL_MAX=2
# PG_IDLE_MS=25000
# CA bundle for TLS verification (TLS is always on)
# PGSSLROOTCERT=
