{
  "name": "pg-sqldev",
  "version": "0.1.0",
  "description": "Local, read-only MCP server that surfaces PostgreSQL catalog facts for SQL development.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "probe": "node scripts/probe.js",
    "smoke": "node test/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
